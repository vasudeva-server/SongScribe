<configuration>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${songscribe.log.dir}/songscribe.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${songscribe.log.dir}/songscribe.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>7</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>1MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-9level [%logger{0}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress noisy OS-detection fallback warnings from jSystemThemeDetector -->
    <logger name="oshi.software.os.mac.MacOperatingSystem" level="ERROR"/>

    <root level="${songscribe.log.level:-INFO}">
        <appender-ref ref="FILE"/>
    </root>

</configuration>
