{
  "env": {
    "CLAUDE_CODE_TASK_LIST_ID": "SongScribe"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew compileJava:*)",
      "Bash(./scripts/check-style.sh:*)",
      "Bash(./scripts/compile.sh:*)",
      "Bash(./scripts/run.sh:*)",
      "Bash(./scripts/test.sh unit)",
      "Bash(bash:*)",
      "Bash(cat:*)",
      "Bash(done)",
      "Bash(file=$:*)",
      "Bash(find:*)",
      "Bash(git ls-tree:*)",
      "Bash(if echo:*)",
      "Bash(java:*)",
      "Bash(javac:*)",
      "Bash(javap:*)",
      "Bash(mvn:*)",
      "Bash(pkill -f*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "mcp__plugin_compound-engineering_context7__resolve-library-id",
      "mcp__plugin_serena_serena__activate_project",
      "mcp__plugin_serena_serena__check_onboarding_performed",
      "mcp__plugin_serena_serena__list_dir",
      "mcp__plugin_serena_serena__onboarding",
      "mcp__plugin_serena_serena__read_file",
      "mcp__plugin_serena_serena__write_memory",
      "mcp__serena__check_onboarding_performed",
      "mcp__serena__find_file",
      "mcp__serena__initial_instructions",
      "mcp__serena__jet_brains_find_referencing_symbols",
      "mcp__serena__jet_brains_find_symbol",
      "mcp__serena__jet_brains_get_symbols_overview",
      "mcp__serena__jet_brains_type_hierarchy",
      "mcp__serena__list_dir",
      "mcp__serena__list_memories",
      "mcp__serena__onboarding",
      "mcp__serena__read_memory",
      "mcp__serena__rename_symbol",
      "mcp__serena__search_for_pattern",
      "mcp__serena__write_memory",
      "Skill(commit-changes)",
      "Skill(commit-commands:commit)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE '\"file_path\"[[:space:]]*:[[:space:]]*\"[^\"]*\\.(java|kt)\"'; then /Users/aparajita/Developer/projects/SongScribe/scripts/compile.sh 2>&1 | tail -20; fi"
          },
          {
            "type": "command",
            "command": "file=$(echo \"$CLAUDE_TOOL_INPUT\" | sed -n 's/.*\"file_path\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p'); if [[ \"$file\" == *.java || \"$file\" == *.kt ]]; then /Users/aparajita/Developer/projects/SongScribe/scripts/check-style.sh \"$file\"; fi"
          }
        ]
      }
    ]
  },
  "plansDirectory": "plans"
}
