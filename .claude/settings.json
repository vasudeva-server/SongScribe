{
  "env": {
    "CLAUDE_CODE_TASK_LIST_ID": "SongScribe"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew compileJava:*)",
      "Bash(./scripts/check-style.sh:*)",
      "Bash(./scripts/compile.sh:*)",
      "Bash(./scripts/run.sh:*)",
      "Bash(./scripts/test.sh:*)",
      "Bash(bash:*)",
      "Bash(cat:*)",
      "Bash(done)",
      "Bash(file=$:*)",
      "Bash(find:*)",
      "Bash(for:*)",
      "Bash(gh issue:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-tree:*)",
      "Bash(if echo:*)",
      "Bash(java:*)",
      "Bash(javac:*)",
      "Bash(javap:*)",
      "Bash(mvn:*)",
      "Bash(pkill -f*)",
      "Bash(roughdraft open *)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Edit(.claude/commands/*)",
      "mcp__serena__check_onboarding_performed",
      "mcp__serena__find_file",
      "mcp__serena__initial_instructions",
      "mcp__serena__jet_brains_find_declaration",
      "mcp__serena__jet_brains_find_implementations",
      "mcp__serena__jet_brains_find_referencing_symbols",
      "mcp__serena__jet_brains_find_symbol",
      "mcp__serena__jet_brains_get_symbols_overview",
      "mcp__serena__jet_brains_inline_symbol",
      "mcp__serena__jet_brains_move",
      "mcp__serena__jet_brains_safe_delete",
      "mcp__serena__jet_brains_type_hierarchy",
      "mcp__serena__jet_brains_rename",
      "mcp__serena__list_dir",
      "mcp__serena__list_memories",
      "mcp__serena__onboarding",
      "mcp__serena__read_memory",
      "mcp__serena__rename_symbol",
      "mcp__serena__search_for_pattern",
      "mcp__serena__write_memory",
      "WebFetch",
      "WebSearch",
      "Read(~/Library/Logs/SongScribe/songscribe.log)",
      "Bash(rtk find *)",
      "Bash(rtk git:*)",
      "Bash(rtk ls *)",
      "Bash(rtk read:*)",
      "Bash(rtk write:*)",
      "Bash(rtk grep:*)"
    ],
    "ask": [
      "Bash(./scripts/test.sh e2e:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/java-whole-file-read.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "plansDirectory": "plans"
}
